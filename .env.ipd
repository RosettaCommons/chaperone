# IPD environment overrides (checked into git).
# Loaded automatically when /projects/ml/pipelines exists.

# Caches
HF_HUB_CACHE="/projects/ml/pipelines/weights/huggingface/hub/"
BOLTZ_CACHE_DIR="/projects/ml/pipelines/weights/boltz2"
AF3_JAX_CACHE_DIR="/projects/ml/pipelines/weights/af3_cache"
ALPHAFOLD3_WEIGHTS_DIR="/net/databases/alphafold"
OPENFOLD3_CACHE_DIR="/projects/ml/pipelines/weights/openfold3"
PROTENIX_CACHE_DIR="/projects/ml/pipelines/cache/protenix"
# Softwares
DUNBRACK_LIBRARY_COPY="/projects/ml/pipelines/software/rotamer_library"
HBPLUS_COPY="/projects/ml/pipelines/software/hbplus"
ROSETTA_BIN="/software/rosetta/latest/bin/rosetta_scripts.hdf5.linuxgccrelease"
PYROSETTA_PATH="/net/software/pyrosetta3.12/latest/setup"
MOLFILE_TO_PARAMS_SCRIPT="/software/rosetta/main/source/scripts/python/public/molfile_to_params.py"
FOLDSEEK_EXEC="/net/software/foldseek/bin/foldseek"
RPXDOCK_CONTAINER="/net/software/containers/versions/rpxdock/rpxdock_231009.sif"
X3DNA_BIN_DIR="/projects/ml/pipelines/software/x3dna-v2.3/bin"
X3DNA_DIR="/projects/ml/pipelines/software/x3dna-v2.3/x3dna-v2.3"
RFDIFFUSION_WEIGHTS_DIR="/projects/ml/pipelines/weights/rfdiffusion"
FOUNDRY_DEV_PATH="/projects/ml/pipelines/software/foundry-dev"
FOUNDRY_DEV_SIF="/net/software/containers/versions/modelhub/rf3-dev.sif"

MPNN_WEIGHTS_DIR="/databases/mpnn"
CHAI_DOWNLOADS_DIR="/projects/ml/pipelines/weights/chai"

# Checkpoint, container and data dirs
FOUNDRY_CHECKPOINT_DIRS="/projects/ml/pipelines/weights/foundry:/projects/ml/pipelines/weights/foundry/checkpoints"
CCD_MIRROR_PATH="/projects/ml/frozen_pdb_copies/2024_12_11_ccd"
# The older mirror is missing 22 entries in the protein validation cohort.
PDB_MIRROR_PATH="/projects/ml/frozen_pdb_copies/2026_01_06_pdb"
# Search order is priority order, first match wins. The project directory holds
# the Blackwell (sm_120) rebuilds, so it must precede the shared directory —
# otherwise an older same-named image there shadows them and CUDA fails with
# "no kernel image is available for execution on the device" on B4000 nodes.
CHAPERONE_CONTAINER_DIRS="/projects/ml/pipelines/containers:/net/software/containers/pipelines"

# Sharded protein MSA stores (sequence-hash keyed), the same roots RF3 validation
# reads. Each store is listed under all three names it can appear as: the squash
# automount key used on compute nodes (/squash/<name>), the raw autofs key
# (/squash/msas^<name>), and the always-present NFS path (/projects/msa/<name>).
# Roots are searched in order and the first existing hit wins, so a node that
# mounts none of the squash images still resolves via /projects/msa.
PROTEIN_MSA_DIRS='[{"dir": "/squash/hhblits", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/squash/msas^hhblits", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/projects/msa/hhblits", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/squash/mmseqs_gpu", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/squash/msas^mmseqs_gpu", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/projects/msa/mmseqs_gpu", "extension": ".a3m.gz", "directory_depth": 2}, {"dir": "/projects/msa/lab", "extension": ".a3m.gz", "directory_depth": 1}]'
