Bootstrap: docker
From: ubuntu:24.04

# Shared Chaperone host/agent runtime; build from the repository root.
# Copy only framework packages;
# never copy the repository root or src/chaperone-evals into an agent image.
%files
    pyproject.toml /opt/chaperone-build/pyproject.toml
    README.md /opt/chaperone-build/README.md
    LICENSE /opt/chaperone-build/LICENSE
    THIRD_PARTY_NOTICES.md /opt/chaperone-build/THIRD_PARTY_NOTICES.md
    src/blocks /opt/chaperone-build/src/blocks
    src/chaperone /opt/chaperone-build/src/chaperone
    src/chaperone_cli /opt/chaperone-build/src/chaperone_cli

%post
    set -eu
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv bash ca-certificates curl git procps \
        build-essential swig libopenbabel-dev libgomp1 libglib2.0-0t64 libfuse3-3
    # Non-setuid Apptainer for nested scientific block containers.
    # https://apptainer.org/docs/admin/1.4/installation.html
    APPTAINER_VERSION=1.4.5
    architecture=$(dpkg --print-architecture)
    curl -fL "https://github.com/apptainer/apptainer/releases/download/v${APPTAINER_VERSION}/apptainer_${APPTAINER_VERSION}_${architecture}.deb" -o /tmp/apptainer.deb
    apt-get install -y /tmp/apptainer.deb
    rm /tmp/apptainer.deb
    python3 -m venv /opt/chaperone/.venv
    /opt/chaperone/.venv/bin/pip install --no-cache-dir --upgrade 'pip>=26.2.2'
    /opt/chaperone/.venv/bin/pip install --no-cache-dir --upgrade 'pip>=26.2.2'
    # The controller orchestrates GPU work in separate model containers.
    /opt/chaperone/.venv/bin/pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
    # Host-side helpers required by the evaluation controller runtime probe.
    # Keep PLIP/OpenBabel/lxml aligned with run_eval._SCORING_PACKAGES.
    /opt/chaperone/.venv/bin/pip install --no-cache-dir '/opt/chaperone-build[plip]' \
        'atomworks[ml,catcif]==3.0.1' 'biotite==1.6.0' \
        ml-collections parasail plip==3.0.1 openbabel==3.2.1 lxml==6.1.1
    /opt/chaperone/.venv/bin/pip check
    rm -rf /opt/chaperone-build /var/lib/apt/lists/*

%environment
    export PATH=/opt/chaperone/.venv/bin:$PATH
    export OPENBLAS_NUM_THREADS=1

%test
    apptainer --version
    /opt/chaperone/.venv/bin/python -c 'from importlib.metadata import version; import chaperone, atomworks, biotite, catcif_tools, ml_collections, openbabel, parasail, plip; assert version("atomworks") == "3.0.1"; assert version("biotite") == "1.6.0"'
    /opt/chaperone/.venv/bin/chaperone list-blocks

%labels
    AtomWorks 3.0.1
    Biotite 1.6.0
