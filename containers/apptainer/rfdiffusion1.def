BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        software-properties-common \
        wget
    rm -rf /var/lib/apt/lists/*

%files
    sources/rfdiffusion1/repos/0/RFdiffusion /opt/RFdiffusion

%post
    cd /
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub | gpg --dearmor -o /etc/apt/keyrings/nvidia-cuda.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64 /" > /etc/apt/sources.list.d/cuda.list
    apt-get update && apt-get install -y cuda-toolkit-12-8

%post
    cd /
    python3.12 -m venv /opt/rfd1-env
    . /opt/rfd1-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    git -C /opt/RFdiffusion checkout 86507b6538f51fce57b5a72477165f03999ed7ae

%post
    cd /
    . /opt/rfd1-env/bin/activate && pip install --no-cache-dir torch==2.4.0+cu124 dgl==2.4.0+cu124 --extra-index-url https://download.pytorch.org/whl/cu124 -f https://data.dgl.ai/wheels/torch-2.4/cu124/repo.html

%post
    cd /
    . /opt/rfd1-env/bin/activate && pip install --no-cache-dir wandb pynvml 'git+https://github.com/NVIDIA/dllogger#egg=dllogger' decorator && cd /opt/RFdiffusion/env/SE3Transformer && pip install --no-build-isolation --no-cache-dir .

%post
    cd /
    . /opt/rfd1-env/bin/activate && pip install --no-cache-dir hydra-core pyrsistent icecream opt-einsum 'numpy==1.26.4' 'e3nn==0.5.1'

%post
    cd /
    . /opt/rfd1-env/bin/activate && DGLBACKEND=pytorch PYTHONPATH=/opt/RFdiffusion python -c 'import torch, dgl; import rfdiffusion.inference.model_runners; assert torch.__version__ == "2.4.0+cu124"; assert dgl.__version__ == "2.4.0+cu124"'

%post
    cd /
    mkdir -p /opt/RFdiffusion/models
    mkdir -p /opt/RFdiffusion/schedules

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export DGLBACKEND=pytorch
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/rfd1-env/bin:/usr/local/cuda/bin:$PATH
    export PYTHONPATH=/opt/RFdiffusion:$PYTHONPATH
    export VIRTUAL_ENV=/opt/rfd1-env
%post
    export CUDA_HOME=/usr/local/cuda
    export DGLBACKEND=pytorch
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/rfd1-env/bin:/usr/local/cuda/bin:$PATH
    export PYTHONPATH=/opt/RFdiffusion:$PYTHONPATH
    export VIRTUAL_ENV=/opt/rfd1-env

%labels
    CUDA 12.6
    Source https://github.com/RosettaCommons/RFdiffusion
    Version v1.1.0

%runscript
    exec "$@"
