BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        kalign \
        ninja-build \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub | gpg --dearmor -o /etc/apt/keyrings/nvidia-cuda.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64 /" > /etc/apt/sources.list.d/cuda.list
    apt-get update && apt-get install -y cuda-toolkit-12-8

%post
    cd /
    mkdir -p /opt/hmmer_build /usr/local/hmmer
    wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz -P /opt/hmmer_build
    cd /opt/hmmer_build && echo 'ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3 hmmer-3.4.tar.gz' | sha256sum --check
    cd /opt/hmmer_build && tar zxf hmmer-3.4.tar.gz && rm hmmer-3.4.tar.gz
    cd /opt/hmmer_build/hmmer-3.4 && ./configure --prefix /usr/local/hmmer && make -j4 && make install
    cd /opt/hmmer_build/hmmer-3.4/easel && make install
    rm -rf /opt/hmmer_build

%post
    cd /
    python3.12 -m venv /opt/protenix-env
    . /opt/protenix-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    . /opt/protenix-env/bin/activate && pip install torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128
    . /opt/protenix-env/bin/activate && pip install protenix==2.0.0 && pip check

%post
    cd /
    /opt/protenix-env/bin/python -c 'from pathlib import Path; p = Path('"'"'/opt/protenix-env/lib/python3.12/site-packages/protenix/model/layer_norm/torch_ext_compile.py'"'"'); s = p.read_text(); old = '"'"'("100", "100"),'"'"'; assert s.count(old) == 1, '"'"'Protenix CUDA architecture patch no longer matches'"'"'; p.write_text(s.replace(old, old + '"'"'\n        ("120", "120"),'"'"'))'
    CUDA_HOME=/usr/local/cuda MAX_JOBS=2 /opt/protenix-env/bin/python -c 'import torch; import runner.batch_inference; assert torch.__version__ == "2.7.1+cu128"; assert torch.version.cuda == "12.8"'

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/protenix-env/bin:/usr/local/cuda/bin:/usr/local/hmmer/bin:$PATH
    export VIRTUAL_ENV=/opt/protenix-env
%post
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/protenix-env/bin:/usr/local/cuda/bin:/usr/local/hmmer/bin:$PATH
    export VIRTUAL_ENV=/opt/protenix-env

%labels
    CUDA 12.8
    PyTorch 2.7.1
    Version 2.0.0

%runscript
    exec "$@"
