BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%files
    sources/ligandmpnn/repos/0/LigandMPNN /opt/ligandmpnn

%post
    cd /
    python3.12 -m venv /opt/mpnn-env
    /opt/mpnn-env/bin/pip install --upgrade pip setuptools wheel
    /opt/mpnn-env/bin/pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    /opt/mpnn-env/bin/pip install numpy==1.26.4 prody==2.6.1 scipy biopython ml-collections dm-tree

%post
    cd /
    git -C /opt/ligandmpnn checkout 26ec57ac976ade5379920dbd43c7f97a91cf82de
    /opt/mpnn-env/bin/python -c '
from pathlib import Path
import re
root = Path('"'"'/opt/ligandmpnn'"'"') / "openfold"
for filename, alias, expected in [
    ("np/residue_constants.py", "int", 3),
    ("data/templates.py", "object", 2),
    ("np/relax/utils.py", "bool", 1),
]:
    path = root / filename
    source = path.read_text()
    patched, count = re.subn(r"\bnp\." + alias + r"\b", alias, source)
    if count != expected:
        raise RuntimeError(f"Unexpected NumPy alias count in {path}: {count}, expected {expected}")
    path.write_text(patched)
'
    mkdir -p /opt/ligandmpnn/model_params
    if [ "${MPNN_USE_MIRROR:-0}" = 1 ] || ! wget --timeout=30 --tries=2 -q https://files.ipd.uw.edu/pub/ligandmpnn/proteinmpnn_v_48_002.pt -O /opt/ligandmpnn/model_params/proteinmpnn_v_48_002.pt; then MPNN_USE_MIRROR=1; wget --timeout=30 --tries=2 -q https://huggingface.co/zcpbx/ligandmpnn-weights/resolve/717f35008c45f6dd384a5e6cb0caab3ce99f28fc/model_params/proteinmpnn_v_48_002.pt -O /opt/ligandmpnn/model_params/proteinmpnn_v_48_002.pt || exit 1; fi; echo '925f2ca1007bf9b02e0e7f420ff00eb91f50fcc2722f64b42e644ae95adaa131  /opt/ligandmpnn/model_params/proteinmpnn_v_48_002.pt' | sha256sum -c - || exit 1
