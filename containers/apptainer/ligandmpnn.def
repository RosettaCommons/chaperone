    /opt/mpnn-env/bin/pip check
    cd /opt/ligandmpnn && /opt/mpnn-env/bin/python -c 'import run, data_utils, model_utils, sc_utils; import pathlib, torch; [torch.load(p, map_location="cpu", weights_only=True)["model_state_dict"] for p in pathlib.Path("model_params").glob("*.pt")]'
    /opt/mpnn-env/bin/python /opt/ligandmpnn/run.py --help >/dev/null
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/mpnn-env/bin:$PATH
    export PYTHONPATH=/opt/ligandmpnn
    export VIRTUAL_ENV=/opt/mpnn-env
%post
    export PATH=/opt/mpnn-env/bin:$PATH
    export PYTHONPATH=/opt/ligandmpnn
    export VIRTUAL_ENV=/opt/mpnn-env

%labels
    CUDA 12.8
    License MIT
    Version LigandMPNN-26ec57ac976ade5379920dbd43c7f97a91cf82de

%runscript
    exec "$@"
