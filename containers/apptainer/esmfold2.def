BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%files
    sources/esmfold2/files/0/run_esmfold2_runner.py /opt/esmfold2/run_esmfold2_runner.py

%post
    cd /
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub | gpg --dearmor -o /etc/apt/keyrings/nvidia-cuda.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64 /" > /etc/apt/sources.list.d/cuda.list
    apt-get update && apt-get install -y cuda-toolkit-13-0

%post
    cd /
    python3.12 -m venv /opt/esmfold2-env
    . /opt/esmfold2-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    . /opt/esmfold2-env/bin/activate && pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cu130

%post
    cd /
    . /opt/esmfold2-env/bin/activate && pip install esm==3.4.1.post1 && pip check
    /opt/esmfold2-env/bin/python -c 'from esm.models.esmfold2 import EsmFold2Model, ESMFold2InputBuilder'

%post
    cd /
    mkdir -p /opt/esmfold2

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/esmfold2-env/bin:/usr/local/cuda/bin:$PATH
    export VIRTUAL_ENV=/opt/esmfold2-env
%post
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/esmfold2-env/bin:/usr/local/cuda/bin:$PATH
    export VIRTUAL_ENV=/opt/esmfold2-env

%labels
    CUDA 13.0
    Version esm-3.4.1.post1/torch-2.11.0

%runscript
    exec "$@"
