BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        bzip2 \
        ca-certificates \
        curl \
        git \
        libaio-dev \
        libjpeg-dev \
        libpng-dev \
        libx11-6 \
        libxau6 \
        libxext6 \
        libxrender1 \
        wget
    rm -rf /var/lib/apt/lists/*

%files
    sources/rfdiffusion2_portable/repos/0/RFdiffusion2 /opt/RFdiffusion2

%post
    cd /
    wget -q -O /tmp/miniforge.sh https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda && rm /tmp/miniforge.sh
    /opt/conda/bin/conda create --yes -p /opt/rfd2-env -c nvidia/label/cuda-12.4.0 -c https://conda.rosettacommons.org -c pytorch -c dglteam/label/th24_cu124 python==3.11 pip 'numpy<2' matplotlib dgl conda-forge::openbabel==3.1.1 cuda pytorch==2.4 pytorch-cuda==12.4 pyrosetta

%post
    cd /
    export PATH=/opt/rfd2-env/bin:$PATH && pip install --no-cache-dir hydra-core==1.3.1 ml-collections==0.1.1 addict==2.4.0 assertpy==1.1.0 biopython==1.83 colorlog compact-json cython==3.0.0 cytoolz==0.12.3 deepdiff==6.3.0 dm-tree==0.1.8 e3nn==0.5.1 einops==0.7.0 executing==2.0.0 fastparquet==2024.5.0 fire==0.6.0 GPUtil==1.4.0 icecream==2.1.3 mdtraj==1.10.0 numba omegaconf==2.3.0 opt_einsum==3.3.0 pandas==1.5.0 plotly==5.16.1 py3Dmol==2.2.1 pyarrow==17.0.0 pydantic pyrsistent==0.19.3 rdkit==2024.3.5 RestrictedPython scipy==1.13.1 seaborn==0.13.2 submitit sympy==1.13.2 tmtools tqdm==4.65.0 typer==0.12.5 wandb==0.13.10 biotite torchdata==0.9.0
    export PATH=/opt/rfd2-env/bin:$PATH && pip install --no-cache-dir pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv -f https://data.pyg.org/whl/torch-2.4.0+cu124.html
    export PATH=/opt/rfd2-env/bin:$PATH && pip install --no-cache-dir -U -i https://pypi.anaconda.org/rapidsai-wheels-nightly/simple "pylibcugraphops-cu12>=24.6.0a24"
    export PATH=/opt/rfd2-env/bin:$PATH && pip install --no-cache-dir deepspeed==0.15.1
    export PATH=/opt/rfd2-env/bin:$PATH && pip install --no-cache-dir git+https://github.com/RalphMao/PyTimer.git git+https://github.com/baker-laboratory/ipd.git
    export PATH=/opt/rfd2-env/bin:$PATH && pip uninstall -y ipd
    git clone --depth 1 -b v3.5.1 https://github.com/NVIDIA/cutlass /opt/cutlass

%post
    cd /
    mkdir -p /opt/rfd2-weights && curl -fL --retry 5 -o /opt/rfd2-weights/RFD_173.pt https://files.ipd.uw.edu/pub/rfdiffusion2/model_weights/RFD_173.pt && echo '590e126057f780afc1249d29545f0f90635562b1a3df5aff013afcfc39c3d3c3  /opt/rfd2-weights/RFD_173.pt' | sha256sum -c -
    cd /opt/RFdiffusion2 && git checkout d365cbf4db3958814a9f8e4f6f94fa309dfebc2b
    /opt/conda/bin/conda clean -a -y
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUTLASS_PATH=/opt/cutlass/
    export MKL_SERVICE_FORCE_INTEL=1
    export PATH=/opt/rfd2-env/bin:$PATH
    export PYTHONPATH=/opt/RFdiffusion2
%post
    export CUTLASS_PATH=/opt/cutlass/
    export MKL_SERVICE_FORCE_INTEL=1
    export PATH=/opt/rfd2-env/bin:$PATH
    export PYTHONPATH=/opt/RFdiffusion2

%labels
    CUDA 12.4
    Source RosettaCommons/RFdiffusion2
    Version d365cbf

%runscript
    exec python "$@"
