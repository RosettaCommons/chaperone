BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv
    rm -rf /var/lib/apt/lists/*

%files
    sources/simplefold/repos/0/ml-simplefold /opt/simplefold

%files
    sources/simplefold/files/0/run_simplefold.py /opt/simplefold/run_simplefold.py

%post
    cd /
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub | gpg --dearmor -o /etc/apt/keyrings/nvidia-cuda.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64 /" > /etc/apt/sources.list.d/cuda.list
    apt-get update && apt-get install -y cuda-toolkit-12-8

%post
    cd /
    python3.12 -m venv /opt/simplefold-env
    . /opt/simplefold-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    . /opt/simplefold-env/bin/activate && pip install torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128 && pip install fair-esm==2.0.0

%post
    cd /
    cd /opt/simplefold && git checkout c7a5570a6be9f5c695126e27c804e77567209934
    . /opt/simplefold-env/bin/activate && cd /opt/simplefold && pip install . && pip check
    /opt/simplefold-env/bin/python -c 'import sys, simplefold; from pathlib import Path; sys.path.append(str(Path(simplefold.__file__).parent)); from simplefold import inference'

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/simplefold-env/bin:/usr/local/cuda/bin:$PATH
    export VIRTUAL_ENV=/opt/simplefold-env
%post
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/simplefold-env/bin:/usr/local/cuda/bin:$PATH
    export VIRTUAL_ENV=/opt/simplefold-env

%labels
    CUDA 12.8
    Source apple/ml-simplefold
    Version c7a5570a6be9f5c695126e27c804e77567209934

%runscript
    exec "$@"
