BootStrap: docker
From: ubuntu:24.04
%post
    . /.singularity.d/env/10-docker*.sh

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    git clone https://github.com/RosettaCommons/foundry.git /opt/foundry
    git -C /opt/foundry fetch origin refs/pull/404/head
    git -C /opt/foundry checkout --detach 54d188b3c0c27654a01c875b173148a508fcd858
    python3.12 -m venv /opt/rfo-env
    /opt/rfo-env/bin/pip install --upgrade pip setuptools wheel
    /opt/rfo-env/bin/pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    /opt/rfo-env/bin/pip install -e '/opt/foundry[rf3,rfo]' 'atomworks[ml]==3.0.1' biotite==1.6.0 numpy==2.4.3 lightning==2.6.1 torch==2.11.0
    python3.12 -m venv /opt/boltz-env
    /opt/boltz-env/bin/pip install --upgrade pip setuptools wheel
    /opt/boltz-env/bin/pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    /opt/boltz-env/bin/pip install 'boltz[cuda]==2.2.1' numpy==1.26.4 torch==2.11.0
    python3.12 -m venv /opt/mpnn-env
    /opt/mpnn-env/bin/pip install --upgrade pip setuptools wheel
    /opt/mpnn-env/bin/pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    /opt/mpnn-env/bin/pip install numpy==1.26.4 prody==2.6.1 scipy biopython ml-collections dm-tree
    git clone https://github.com/dauparas/LigandMPNN.git /opt/ligandmpnn
    git -C /opt/ligandmpnn checkout --detach 26ec57ac976ade5379920dbd43c7f97a91cf82de
    /opt/mpnn-env/bin/python -c '
from pathlib import Path
import re
root = Path('"'"'/opt/ligandmpnn'"'"') / "openfold"
for filename, alias, expected in [
    ("np/residue_constants.py", "int", 3),
    ("data/templates.py", "object", 2),
    ("np/relax/utils.py", "bool", 1),
]:
    path = root / filename
    source = path.read_text()
    patched, count = re.subn(r"\bnp\." + alias + r"\b", alias, source)
    if count != expected:
        raise RuntimeError(f"Unexpected NumPy alias count in {path}: {count}, expected {expected}")
    path.write_text(patched)
'
    mkdir -p /opt/ligandmpnn/model_params
    wget --timeout=30 --tries=3 -q https://huggingface.co/zcpbx/ligandmpnn-weights/resolve/717f35008c45f6dd384a5e6cb0caab3ce99f28fc/model_params/proteinmpnn_v_48_020.pt -O /opt/ligandmpnn/model_params/proteinmpnn_v_48_020.pt && echo 'c9cb4a671d79604111231f8dbfc7c590e06f1197453b7a6854ac6661a642f5bd  /opt/ligandmpnn/model_params/proteinmpnn_v_48_020.pt' | sha256sum -c -
    wget --timeout=30 --tries=3 -q https://huggingface.co/zcpbx/ligandmpnn-weights/resolve/717f35008c45f6dd384a5e6cb0caab3ce99f28fc/model_params/ligandmpnn_v_32_010_25.pt -O /opt/ligandmpnn/model_params/ligandmpnn_v_32_010_25.pt && echo '161cd264061fda9680cbb940255522ae42f2966c552d045d87913d9452a80970  /opt/ligandmpnn/model_params/ligandmpnn_v_32_010_25.pt' | sha256sum -c -
    /opt/rfo-env/bin/pip check
    /opt/boltz-env/bin/pip check
    /opt/mpnn-env/bin/pip check
    /opt/rfo-env/bin/rfo --help >/dev/null
    /opt/rfo-env/bin/python -c 'from importlib.metadata import version; assert version("rc-foundry") == "1.0.0"; assert version("atomworks") == "3.0.1"; assert version("biotite") == "1.6.0"'
    /opt/rfo-env/bin/python -c 'import rfo.backprop.optimize; import rf3.inference_engines.rf3; from rfo.backprop.tools import af3_auto_detect_breaking, af3_no_breaking_point'
    /opt/boltz-env/bin/boltz predict --help >/dev/null
    /opt/mpnn-env/bin/python /opt/ligandmpnn/run.py --help >/dev/null
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/rfo-env/bin:$PATH
    export VIRTUAL_ENV=/opt/rfo-env
%post
    export PATH=/opt/rfo-env/bin:$PATH
    export VIRTUAL_ENV=/opt/rfo-env

%labels
    AtomWorks 3.0.1
    Boltz 2.2.1
    Foundry 54d188b3c0c27654a01c875b173148a508fcd858
    LigandMPNN 26ec57ac976ade5379920dbd43c7f97a91cf82de

%runscript
    exec "$@"
