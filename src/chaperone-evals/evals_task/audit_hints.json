[
  {
    "label": "hammerhead target name",
    "pattern": "\\bhammerhead\\b",
    "ignore_case": true
  },
  {
    "label": "hammerhead PDB id",
    "pattern": "\\b2oeu\\b",
    "ignore_case": true
  },
  {
    "label": "internal target id",
    "pattern": "\\brz[-_ ]?01\\b",
    "ignore_case": true
  },
  {
    "label": "held-out Rfam family",
    "pattern": "\\brf00163\\b",
    "ignore_case": true
  },
  {
    "label": "held-out native label",
    "pattern": "\\bnative[_-]?2oeu\\b",
    "ignore_case": true
  },
  {
    "label": "held-out novelty cutoff",
    "pattern": "(?<!\\d)0\\.563(?!\\d)",
    "ignore_case": false
  },
  {
    "label": "target motif range",
    "pattern": "\\bA20-22\\b",
    "ignore_case": true
  },
  {
    "label": "target motif range",
    "pattern": "\\bB6-7\\b",
    "ignore_case": true
  },
  {
    "label": "held-out novelty panel size",
    "pattern": "\\b503\\s+(?:natural|reference|homolog)",
    "ignore_case": true
  },
  {
    "label": "pdl1: interface min-PAE gate value",
    "pattern": "min[_ ]?pae[^\\n]{0,60}(?<![\\d.])1\\.25(?![\\d])",
    "ignore_case": true
  },
  {
    "label": "pdl1: scorer metric namespace iface.*",
    "pattern": "\\biface\\.(?:ipae|min_pae)\\b|n_min_pae_(?:good|excellent)",
    "ignore_case": true
  },
  {
    "label": "biotin: held-out holo template / reference ligand / eval name",
    "pattern": "biotin_holo_template|biotin_reference|\\bbiotin_eval\\b|\\bbiotin-binder-design\\b",
    "ignore_case": true
  },
  {
    "label": "biotin: scorer contact_ms 140 / min-PAE 1.5 gate",
    "pattern": "(?:contact_ms[^\\n]{0,40}(?<![\\d.])140(?![\\d])|min_pae_interaction[^\\n]{0,40}(?<![\\d.])1\\.5(?![\\d]))",
    "ignore_case": true
  },
  {
    "label": "biotin: calibration cutoff text (CUTOFF, relaxed gate, 1440/2112 designs)",
    "pattern": "relax(?:ing|ed)[^\\n]{0,40}\\bgate\\b|\\b(?:1440|2,?112)\\b[^\\n]{0,30}designs|pi_stacking_or_cation|core_max_rasa|linker_max_rasa",
    "ignore_case": true
  },
  {
    "label": "antibody: held-out ipSAE recalibration / cutoff 15",
    "pattern": "ipsae[^\\n]{0,80}pae_cutoff\\s*=?\\s*15|pae_cutoff\\s*=\\s*15(?:\\.0)?\\b",
    "ignore_case": true
  },
  {
    "label": "antibody: scorer-only framework-region contract helpers",
    "pattern": "\\bFixedRegionSpec\\b|\\bVariableRegion\\b|\\bfixed_positions\\(|\\bregion_spans\\(",
    "ignore_case": true
  },
  {
    "label": "antibody: native-control values",
    "pattern": "\\b0\\.114\\b|native D1\\.3",
    "ignore_case": true
  },
  {
    "label": "dna: calibration-anchor PDB ids",
    "pattern": "\\b(?:1AAY|1ZAA|1A1F|1LMB|1PER|1HDD|1FJL|1MDY|6CRO)\\b",
    "ignore_case": false
  },
  {
    "label": "dna: published pipeline the scorer follows",
    "pattern": "sehgal2026dnabinder|\\bSehgal\\b",
    "ignore_case": true
  },
  {
    "label": "dna: scorer instance names",
    "pattern": "\\bscore_(?:ipsae|dssr|rmsd)\\.(?:min_pae_interface|Major_hbond|nucleotide)",
    "ignore_case": true
  },
  {
    "label": "glyco: held-out AF3 holo template / cache version",
    "pattern": "glycosidase_holo_template|holo-ligand-v1|SCORER_CACHE_VERSION",
    "ignore_case": true
  },
  {
    "label": "glyco: reference dyad / substrate distances",
    "pattern": "(?:dyad|carboxylate|\\bCD\\b|anomeric|glycosidic|nucleophile)[^\\n]{0,60}(?<![\\d.])(?:7\\.387|2\\.477|2\\.810)(?![\\d])|(?<![\\d.])(?:7\\.387|2\\.477|2\\.810)(?![\\d])\\s*(?:\u00c5|A\\b)",
    "ignore_case": true
  },
  {
    "label": "glyco: ligand pLDDT gate",
    "pattern": "\\bholo\\.ligand_plddt\\b|ligand[_ ]plddt[^\\n]{0,30}(?<![\\d.])70(?![\\d])",
    "ignore_case": true
  },
  {
    "label": "protease: design-substrate interface PAE gate",
    "pattern": "holo_ipsae\\.min_pae_interface[^\\n]{0,20}(?<![\\d.])10(?![\\d.])|INTERFACE_PAE_MAX",
    "ignore_case": true
  },
  {
    "label": "protease: reference-run results / readme example map",
    "pattern": "H293:A(?:45|124)\\b|\\b35\\s*/\\s*96\\b|\\b77\\s*/\\s*96\\b",
    "ignore_case": true
  },
  {
    "label": "protease: substrate peptide id",
    "pattern": "GPRVVERHQS",
    "ignore_case": true
  },
  {
    "label": "c3: reference-run compactness numbers",
    "pattern": "(?:radius of gyration|\\bRg\\b|compactness)[^\\n]{0,80}(?<![\\d.])(?:14\\.08|29\\.76|30\\.16|30\\.39)(?![\\d])",
    "ignore_case": true
  },
  {
    "label": "c3: scorer-only compactness helper / metric name",
    "pattern": "\\bca_radius_of_gyration\\b|\\bprotomer\\.ca_radius_of_gyration\\b|\\bscore_symmetry\\.",
    "ignore_case": true
  },
  {
    "label": "peptide: scorer epitope derivation / pose metric names",
    "pattern": "prepare_target\\.py|\\bCORE_RESIDUES\\b|pose\\.epitope_rmsd|peptide_core_pose|\\bS9 0\\.91\\b|F10 0\\.98",
    "ignore_case": true
  },
  {
    "label": "peptide: AF3 min-PAE gate + binder pLDDT gate",
    "pattern": "score_af3\\.min_pae_interaction[^\\n]{0,40}(?<![\\d.])1\\.5(?![\\d])|score_ss\\.mean_plddt[^\\n]{0,20}85",
    "ignore_case": true
  },
  {
    "label": "rz: novelty panel / native reference files",
    "pattern": "homologs\\.fasta|2oeu_native|\\bNATIVE_2OEU\\b|rz-?01-?v\\d",
    "ignore_case": true
  },
  {
    "label": "rz: native sequence fragments (merged 63-nt, chains A/B)",
    "pattern": "GGAUGUACUACCAGCUGAUGAG|GGCGUCCUGGUAUCCAAUCC|CCAGCUGAUGAGUCCCAAAUAGGACG",
    "ignore_case": false
  },
  {
    "label": "rz: calibration provenance",
    "pattern": "shuffled[- ]null|\\b0\\.534\\b|10,?000-design|72/7,?929|\\b164\\.3\\b|rna_motif_scaffolding_benchmark_guide|rna_scaffolding_handoff|memo_extend_motif",
    "ignore_case": true
  },
  {
    "label": "rna: min-PAE gate 2.0",
    "pattern": "score_af3\\.min_pae_interaction[^\\n]{0,30}(?<![\\d.])2(?:\\.0)?(?![\\d])|MIN_PAE_INTERACTION_MAX",
    "ignore_case": true
  },
  {
    "label": "rna: native-complex control values",
    "pattern": "\\b494 ?\u00c5|Total_hbond[^\\n]{0,12}\\b15\\b|\\bnt_aa[^\\n]{0,12}\\b26\\b|\\bMinor_hbond[^\\n]{0,12}\\b7\\b",
    "ignore_case": true
  },
  {
    "label": "rna: reference-run stem/loop distribution",
    "pattern": "160-design|\\b0\\.73\\b[^\\n]{0,20}\\b1\\.08\\b|stem_rmsd|loop_rmsd|rna_stem_conformation",
    "ignore_case": true
  }
]