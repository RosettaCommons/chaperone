Bootstrap: docker
From: ubuntu:24.04

# No Chaperone, scientific dependencies, weights, skills or virtualenv.
%post
    set -eu
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip bash ca-certificates curl git procps \
        build-essential libgomp1 libfuse3-3
    # The baseline deliberately has no Chaperone virtualenv. This is a disposable
    # image, so install the standalone uv binary system-wide. Use uv's installer
    # rather than Ubuntu's older pip (see the 2026 emSign CA incident).
    curl -LsSf https://astral.sh/uv/0.13.4/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    rm -rf /var/lib/apt/lists/*

%test
    python3 --version
    uv --version
